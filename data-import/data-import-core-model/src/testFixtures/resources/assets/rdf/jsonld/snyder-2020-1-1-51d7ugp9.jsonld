        "@id": "_:n52",
        "@type": "doi:abef9f1c0d48853f3e51",
        "doi:abef9f1c0d48853f3e51#has_support_url": "https://search.r-project.org/CRAN/refmans/lme4/html/glmer.html",
        "doi:abef9f1c0d48853f3e51#is_implemented_by": "lme4::glmer(I(FleaBeetle>0) ~ VarietalRichness + PerAg1000 + NumColors + VarietalRichness:PerAg1000 + NumColors:PerAg1000 + (1|PlotNumber) + (1|PlotNumber:Period) + (1|PlotNumber:Period:Point), family=binomial, data=combined, control=glmerControl(optimizer='bobyqa', optCtrl=list(maxfun=1e5)))",
        "doi:abef9f1c0d48853f3e51#part_of": {
          "@id": "_:n53",
          "@type": "doi:4b99260369df9110f9bd",
          "doi:4b99260369df9110f9bd#has_support_url": "https://doi.org/10.32614/CRAN.package.lme4",
